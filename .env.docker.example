FRONTEND_PORT=3000
BACKEND_PORT=8010

# Browser-facing backend URL. Change this on a server, for example:
# NEXT_PUBLIC_API_BASE=https://api.your-domain.com
NEXT_PUBLIC_API_BASE=http://localhost:8010

# Private Telegram bot integration. Get the token from @BotFather and your
# numeric Telegram user ID from @userinfobot. Only this owner ID is accepted.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
AUTO_VIRAL_TELEGRAM_CHAT_ID=
TELEGRAM_CLIP_SUCCESS_ALERTS=true

# Optional public backend URL used only as a fallback link when a clip is over
# Telegram's upload limit. Leave empty for local-only deployments.
TELEGRAM_PUBLIC_BASE_URL=
TELEGRAM_MAX_UPLOAD_MB=49
TELEGRAM_BATTERY_ALERT_ENABLED=true
TELEGRAM_BATTERY_ALERT_LEVELS=20,10,5
TELEGRAM_BATTERY_CHECK_INTERVAL_SECONDS=60
TELEGRAM_AI_BASE_URL=http://127.0.0.1:11434/v1
TELEGRAM_AI_MODEL=llama3.2-id:latest
TELEGRAM_AI_FALLBACK_MODELS=llama3.2-id:latest,llama3:latest
DEFAULT_AI_BASE_URL=http://127.0.0.1:11434/v1
DEFAULT_AI_MODEL=llama3.2-id:latest
DEFAULT_REQUIRED_HASHTAGS=viralindonesia,trendingindonesia,kontenpilihan
# Optional: proper names/brand/technical terms that Whisper must hear accurately.
FENDY_CLIPPER_TRANSCRIPTION_HOTWORDS=
FENDY_CLIPPER_MAX_CONCURRENT_JOBS=3
# Keep parallel CPU-heavy Short jobs responsive on a 20-thread host.
FENDY_CLIPPER_CPU_THREADS_PER_JOB=6
# Prefer NVIDIA for Whisper; CPU remains an automatic safety fallback.
FENDY_CLIPPER_WHISPER_DEVICE=auto
FENDY_CLIPPER_WHISPER_CUDA_COMPUTE_TYPE=float16
FENDY_CLIPPER_WHISPER_CPU_COMPUTE_TYPE=int8
FENDY_CLIPPER_WHISPER_CPU_FALLBACK=true
# Optional for the public Whisper model. Add a read-only Hugging Face token to
# raise download rate limits; never commit the real value.
HF_TOKEN=
# Model cache persists through the existing ./backend/data Docker volume.
HF_HOME=/app/data/huggingface
HF_HUB_CACHE=/app/data/huggingface/hub
HF_HUB_VERBOSITY=error
HF_HUB_DISABLE_PROGRESS_BARS=1
HF_HUB_DOWNLOAD_TIMEOUT=300
HF_HUB_ETAG_TIMEOUT=30
# CTA Shorts: neural Indonesian voice first, local eSpeak fallback.
CTA_VOICEOVER_ENABLED=false
CTA_VOICEOVER_PROVIDER=auto
CTA_VOICEOVER_TEXT=Tulis pendapatmu dan lanjutkan diskusinya!
CTA_VOICEOVER_VOICE=id-ID-ArdiNeural
CTA_VOICEOVER_RATE=+12%
CTA_VOICEOVER_ESPEAK_VOICE=id+m3
# Kartu ayat terkurasi 2,8 detik: setiap Short, sekali di akhir long-form.
QURAN_OUTRO_ENABLED=true
# Finishing filmic default; grain tipis hanya dipakai pada kualitas high/max.
SHORTS_CINEMATIC_FINISH_ENABLED=true
SHORTS_CINEMATIC_GRAIN_ENABLED=true
SHORTS_ADAPTIVE_COLOR_ENABLED=true
SHORTS_RENDER_QC_ENABLED=true
# Backsound CC0 terkurasi disinkronkan hanya saat setup/rebuild, bukan saat render.
BACKGROUND_MUSIC_SYNC_ON_REBUILD=true
SHORTS_BACKGROUND_MUSIC_ENABLED=false
SHORTS_ALLOW_THIRD_PARTY_MUSIC=false
SHORTS_PROCEDURAL_MUSIC_ENABLED=false
BACKGROUND_MUSIC_LIBRARY_DIR=/app/assets/background_music
SHORTS_DIALOGUE_GAIN=0.80
SHORTS_BACKGROUND_MUSIC_GAIN=0.20
SHORTS_MUSIC_DUCKING=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_TITLE=Fendy Clipper

# Generator Cerita: provider wajib nyata; tidak pernah turun ke gambar balok.
LONG_ANIMATE_IMAGE_PROVIDER=stable-diffusion-cpp
LONG_ANIMATE_IMAGE_BASE_URL=http://127.0.0.1:7860/v1
LONG_ANIMATE_IMAGE_MODEL=z-image-turbo-q4-k
LONG_ANIMATE_IMAGE_API_KEY=
LONG_ANIMATE_IMAGE_SIZE=1536x864
LONG_ANIMATE_IMAGE_QUALITY=high
LONG_ANIMATE_IMAGE_OUTPUT_FORMAT=png
LONG_ANIMATE_IMAGE_TIMEOUT_SECONDS=900
LONG_ANIMATE_IMAGE_READY_TIMEOUT_SECONDS=120
LONG_ANIMATE_IMAGE_RETRIES=4
LONG_ANIMATE_IMAGE_STRICT=true
LONG_ANIMATE_ALLOW_PROCEDURAL_IMAGES=false
LONG_ANIMATE_VISION_QA_ATTEMPTS=3
LONG_ANIMATE_VISION_QA_STRICT=true
LONG_ANIMATE_QA_MAX_ENVIRONMENT_FACE_AREA=0.07
# Butuh encoder vision/reference yang kompatibel; false aman untuk GPU 4 GB.
LONG_ANIMATE_LOCAL_REFERENCE_IMAGES=false
LONG_ANIMATE_QA_MIN_FACE_AREA=0.008
LONG_ANIMATE_QA_MIN_FACE_SHARPNESS=32
LONG_ANIMATE_DEFAULT_VISUAL_STYLE=cinematic_realistic
LONG_ANIMATE_VOICE_MODE=auto
LONG_ANIMATE_VOICE_MALE=id-ID-ArdiNeural
LONG_ANIMATE_VOICE_FEMALE=id-ID-GadisNeural
LONG_ANIMATE_DEFAULT_VOICE_GENDER=male
LONG_ANIMATE_VOICE_RATE=-3%
LONG_ANIMATE_VOICE_PITCH=+0Hz
LONG_ANIMATE_VOICE_VOLUME=+0%
LONG_ANIMATE_TTS_ATTEMPTS=3
LONG_ANIMATE_TTS_WORKERS=2
LONG_ANIMATE_TTS_STRICT=true
LONG_ANIMATE_ALLOW_ROBOTIC_TTS_FALLBACK=false

# Gerak video tanpa API berbayar: stock CC Wikimedia + Z-Image lokal.
LONG_ANIMATE_VIDEO_PROVIDER=local_free
LONG_ANIMATE_IMAGE_MOTION_STRENGTH=1.35
LONG_ANIMATE_FREE_STOCK_ENABLED=true
LONG_ANIMATE_FREE_STOCK_MAX_SHOTS=4
LONG_ANIMATE_FREE_STOCK_SEARCH_COUNT=8
LONG_ANIMATE_FREE_STOCK_LICENSES="cc0,public domain,pdm,cc by,cc by-sa"
LONG_ANIMATE_FREE_STOCK_TIMEOUT_SECONDS=30
LONG_ANIMATE_FREE_STOCK_DOWNLOAD_TIMEOUT_SECONDS=180
LONG_ANIMATE_FREE_STOCK_MAX_DOWNLOAD_MB=250

