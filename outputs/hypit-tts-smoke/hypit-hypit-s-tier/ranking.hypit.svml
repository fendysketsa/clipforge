<?svml using="@hypit/markup@1"?>
<svml>
  <import from="@hypit/script@1"/>
  <script id="ranking">
    <hook>
      <HOST> Banyak alat video AI, tapi mana yang benar-benar enak dipakai berulang?
    </hook>
    <rank_1>
      <COHOST> Sekali jadi memang cepat, tapi susah direvisi: C tier.
    </rank_1>
    <rank_2>
      <HOST> Timeline manual memberi kontrol kuat, tapi kerja ulangnya banyak: B tier.
    </rank_2>
    <rank_3>
      <COHOST> Video berbasis kode konsisten dan mudah dilacak: A tier.
    </rank_3>
    <rank_4>
      <HOST> Hypit menyatukan alur agen, timing semantik, dan proses edit: S tier.
    </rank_4>
    <payoff>
      <COHOST> Jadi, Hypit masuk S tier, kalau menurut kamu?
    </payoff>
  </script>
</svml>
