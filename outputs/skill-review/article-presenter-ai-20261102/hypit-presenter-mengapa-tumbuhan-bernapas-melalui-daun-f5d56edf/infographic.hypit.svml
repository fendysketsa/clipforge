<?svml using="@hypit/markup@1"?>
<svml>
  <import from="@hypit/script@1"/>
  <script id="infographic-explainer">
    <hook>
      <HOST> Mari kita pahami mengapa tumbuhan bernapas melalui daun.
    </hook>
    <beat_01>
      <HOST> Tumbuhan membutuhkan oksigen untuk menghasilkan energi.
    </beat_01>
    <beat_02>
      <HOST> Inti penjelasannya: Pada permukaan daun terdapat
    </beat_02>
    <beat_03>
      <HOST> Inti penjelasannya: pori-pori kecil bernama stomata.
    </beat_03>
    <beat_04>
      <HOST> Saat fotosintesis, daun menyerap karbon dioksida dan menghasilkan oksigen.
    </beat_04>
    <beat_05>
      <HOST> tumbuhan menggunakan oksigen untuk menghasilkan energi.
    </beat_05>
    <beat_06>
      <HOST> Inti penjelasannya: Respirasi berlangsung pada siang
    </beat_06>
    <beat_07>
      <HOST> dan malam hari, bukan hanya saat ada matahari.
    </beat_07>
    <payoff>
      <HOST> dan malam hari, bukan hanya saat ada matahari.
    </payoff>
  </script>
</svml>
