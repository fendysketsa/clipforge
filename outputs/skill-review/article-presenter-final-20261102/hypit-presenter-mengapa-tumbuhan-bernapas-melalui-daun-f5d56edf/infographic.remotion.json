      {
        "speaker": "HOST",
        "text": "Mari kita pahami mengapa tumbuhan bernapas melalui daun.",
        "start": 0.0,
        "end": 6.24185452297548
      },
      {
        "speaker": "HOST",
        "text": "Tumbuhan membutuhkan oksigen untuk menghasilkan energi.",
        "start": 6.58185452297548,
        "end": 12.238145477024522
      },
      {
        "speaker": "HOST",
        "text": "Pada permukaan daun terdapat pori-pori kecil bernama stomata.",
        "start": 12.578145477024522,
        "end": 18.94
      },
      {
        "speaker": "HOST",
        "text": "Stomata menjadi tempat pertukaran oksigen dan karbon dioksida.",
        "start": 19.28,
        "end": 25.641854522975482
      },
      {
        "speaker": "HOST",
        "text": "Saat fotosintesis, daun menyerap karbon dioksida dan menghasilkan oksigen.",
        "start": 25.981854522975482,
        "end": 32.93134555944777
      },
      {
        "speaker": "HOST",
        "text": "Saat respirasi, tumbuhan menggunakan oksigen untuk menghasilkan energi.",
        "start": 33.271345559447774,
        "end": 39.63320008242325
      },
      {
        "speaker": "HOST",
        "text": "Respirasi berlangsung pada siang dan malam hari, bukan hanya saat ada matahari.",
