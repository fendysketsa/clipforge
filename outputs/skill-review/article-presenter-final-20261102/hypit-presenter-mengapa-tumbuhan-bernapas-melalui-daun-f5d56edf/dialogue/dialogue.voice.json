      "provider": "edge_neural",
      "voice": "id-ID-ArdiNeural",
      "rate": "+0%",
      "pitch": "+0Hz",
      "tempo_fit": 1.0
    },
    {
      "speaker": "HOST",
      "text": "Stomata menjadi tempat pertukaran oksigen dan karbon dioksida.",
