      "duration": 3.131,
      "provider": "edge_neural",
      "voice": "id-ID-ArdiNeural",
      "rate": "+0%",
      "pitch": "+0Hz",
      "tempo_fit": 1.0
    },
    {
      "speaker": "HOST",
      "text": "Saat fotosintesis, daun menyerap karbon dioksida dan menghasilkan oksigen.",
