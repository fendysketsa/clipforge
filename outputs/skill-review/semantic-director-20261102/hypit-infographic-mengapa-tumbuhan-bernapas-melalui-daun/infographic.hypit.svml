<?svml using="@hypit/markup@1"?>
<svml>
  <import from="@hypit/script@1"/>
  <script id="infographic-explainer">
    <hook>
      <HOST> Mengapa tumbuhan bernapas melalui daun?
    </hook>
    <beat_01>
      <COHOST> Pada permukaan daun terdapat pori-pori kecil bernama stomata
    </beat_01>
    <beat_02>
      <HOST> Saat fotosintesis, daun menyerap karbon dioksida dan menghasilkan oksigen
    </beat_02>
    <beat_03>
      <COHOST> Pada malam hari, tumbuhan menggunakan oksigen untuk menghasilkan energi
    </beat_03>
    <beat_04>
      <HOST> Daun di kebun bergerak saat hujan turun
    </beat_04>
    <beat_05>
      <COHOST> Apakah tumbuhan juga bernapas pada malam hari?
    </beat_05>
    <payoff>
      <COHOST> Tulis jawabanmu di komentar!
    </payoff>
  </script>
</svml>
