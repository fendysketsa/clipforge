{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-history/types/**/*.ts",
    ".next-history/dev/types/**/*.ts",
    ".next-queue/types/**/*.ts",
    ".next-queue/dev/types/**/*.ts",
    ".next-submission/types/**/*.ts",
    ".next-submission/dev/types/**/*.ts",
    ".next-history-four/types/**/*.ts",
    ".next-history-four/dev/types/**/*.ts",
    ".next-director-recovery/types/**/*.ts",
    ".next-director-recovery/dev/types/**/*.ts",
    ".next-compose-check/types/**/*.ts",
    ".next-compose-check/dev/types/**/*.ts",
    ".next-niche-playlist/types/**/*.ts",
    ".next-niche-playlist/dev/types/**/*.ts",
    ".next-upload-connection/types/**/*.ts",
    ".next-upload-connection/dev/types/**/*.ts",
    ".next-proxy-direct/types/**/*.ts",
    ".next-proxy-direct/dev/types/**/*.ts",
    ".next-cron-long/types/**/*.ts",
    ".next-cron-long/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
